# === Documentaliste — variables d'environnement (copier en .env, ne jamais committer) ===

# Mistral : clé d'API pour la rédaction des réponses citées.
MISTRAL_API_KEY=

# Base PostgreSQL/pgvector. En production, l'API joint la base par le réseau Docker,
# d'où l'hôte « base » plutôt que « 127.0.0.1 ».
POSTGRES_DB=documentaliste
POSTGRES_USER=documentaliste
POSTGRES_PASSWORD=
#
# ATTENTION : le mot de passe doit être RECOPIÉ EN CLAIR dans le DSN ci-dessous.
# `env_file` ne substitue aucune variable — écrire « ${POSTGRES_PASSWORD} » ici donnerait
# une chaîne littérale, et la connexion échouerait sur « no password supplied » au premier
# appel, pas au démarrage : le service part correctement et tombe à la première question.
DOCUMENTALISTE_DSN=postgresql://documentaliste:MOT_DE_PASSE_ICI@base:5432/documentaliste

# Mémoire de PostgreSQL. À FIXER D'APRÈS LA MÉMOIRE RÉELLEMENT LIBRE SUR LA CIBLE, pas
# d'après le total : l'auditeur réserve déjà 4 Go sur les 8 du VPS.
#
# `shared_buffers` est une allocation réelle ; `effective_cache_size` n'est qu'une
# indication au planificateur et ne consomme rien. L'index vectoriel pèse 1 551 Mo : en
# dessous, chaque question paie un accès disque — 245 ms mesurées contre 10.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# Construction d'index (restauration d'un dump). ATTENTION : cette valeur s'alloue PAR
# OPÉRATION. Avec `pg_restore -j 3`, la consommation de pointe est le triple. Laisser bas
# ici, et l'élever ponctuellement pendant la restauration en connaissant le produit.
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# === Garde-fou de dépense ===
# Le budget Mistral de la démonstration se compte en cents. Ces trois réglages existent
# pour qu'un accident ne le brûle pas avant le rendez-vous.
#
# Au-delà du plafond, LA RECHERCHE CONTINUE DE FONCTIONNER et seule la rédaction se coupe :
# la démonstration dégrade, elle ne meurt pas.
DOCUMENTALISTE_PLAFOND_APPELS=200      # appels au modèle, cumulés, avant coupure

# Cache des questions déjà posées, et compteur d'appels. **Sur un volume, jamais sur tmpfs.**
#
# En tmpfs, les deux s'effacent à chaque recréation du conteneur : le garde-fou de dépense
# repart de zéro — ce qui vide de sens le plafond ci-dessus — et les questions déjà posées
# repassent toutes par le modèle. Assez, mesuré, pour franchir sa limite de débit et faire
# dégrader le service sans raison apparente.
#
# Le démarrage vérifie que ce dossier est réellement inscriptible et le journalise : les
# erreurs d'écriture sont avalées ailleurs, pour qu'un disque plein ne casse pas une réponse.
DOCUMENTALISTE_CACHE=/var/cache/documentaliste
DOCUMENTALISTE_MODELE=mistral-small-latest

# Moteur d'inférence local pour l'embedding de la question. Cuit dans l'image au build ;
# cette variable doit refléter le `MOTEUR_EMBEDDING` avec lequel l'image a été construite.
DOCUMENTALISTE_MOTEUR=onnx

# === Sécurité API (endpoint public) ===
CORS_ORIGINS=https://lamoulinette.ai,https://www.lamoulinette.ai   # local : http://localhost:9000
TRUST_PROXY=true                       # vrai derrière Caddy (lit X-Forwarded-For)
RATELIMIT_ENABLED=true
RATELIMIT_IP_MAX=20                    # questions max par IP sur la fenêtre
RATELIMIT_IP_WINDOW=3600               # fenêtre IP (s)

# Image (utilisée par docker-compose sur le VPS).
# DOCUMENTALISTE_IMAGE=ghcr.io/lamoulinette-ai/documentaliste:latest
